  "html": "<style>\n    @page {\n        size: A4;\n        margin: 20mm;\n    }\n\n    body {\n        font-family: \"Helvetica\", Arial, sans-serif;\n        font-size: 14px;   /* 👈 Bigger font */\n        color: #2c3e50;\n    }\n\n    .container {\n        width: 100%;\n        max-width: 800px;   /* 👈 Prevent stretching */\n        margin: 0 auto;\n    }\n\n    .header {\n        background: #4CAF50;\n        color: white;\n        padding: 15px;\n        border-radius: 6px;\n        text-align: center;\n    }\n\n    .title {\n        font-size: 26px;   /* 👈 Bigger */\n        font-weight: bold;\n    }\n\n    .po-number {\n        font-size: 14px;\n        margin-top: 5px;\n    }\n\n    .card {\n        border: 1px solid #ddd;\n        border-radius: 6px;\n        padding: 15px;\n        margin-top: 15px;\n        text-align: center;\n    }\n\n    .label {\n        font-weight: bold;\n        font-size: 14px;\n    }\n\n    .badge {\n        display: inline-block;\n        padding: 6px 14px;\n        border-radius: 20px;\n        font-size: 13px;\n        background: #007bff;\n        color: white;\n        margin-top: 5px;\n    }\n\n    .rating {\n        font-size: 22px;   /* 👈 Bigger stars */\n        color: #f1c40f;\n        margin-top: 5px;\n        letter-spacing: 3px;\n    }\n\n    .rating-number {\n        font-size: 14px;\n        color: #555;\n    }\n\n    .warning {\n        margin-top: 10px;\n        padding: 10px;\n        border: 1px solid #f39c12;\n        background: #fff3cd;\n        font-size: 13px;\n        display: inline-block;\n    }\n\n    .table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-top: 15px;\n    }\n\n    .table th {\n        border-bottom: 2px solid #444;\n        padding: 10px;\n        font-size: 14px;\n        text-align: center;\n    }\n\n    .table td {\n        padding: 10px;\n        border-bottom: 1px solid #ddd;\n        font-size: 14px;\n        text-align: center;\n    }\n\n    .total-box {\n        margin-top: 15px;\n        font-size: 18px;   /* 👈 Bigger total */\n        font-weight: bold;\n        text-align: right;\n    }\n\n    .footer {\n        margin-top: 30px;\n        font-size: 12px;\n        text-align: center;\n        color: #888;\n    }\n\n    .watermark {\n        position: fixed;\n        top: 40%;\n        left: 20%;\n        font-size: 80px;\n        color: rgba(150, 150, 150, 0.08);\n        transform: rotate(-25deg);\n        z-index: -1;\n    }\n</style>\n\n<div class=\"watermark\">Vendor Portal</div>\n\n<div class=\"container\">\n\n    <div class=\"header\">\n        <div class=\"title\">Purchase Order</div>\n        <div class=\"po-number\">{{ doc.name }}</div>\n    </div>\n\n    <div class=\"card\">\n        <div><span class=\"label\">Supplier:</span> {{ doc.supplier_name }}</div>\n        <div><span class=\"label\">Transaction Date:</span> {{ doc.transaction_date }}</div>\n    </div>\n\n    {% set supplier = frappe.get_doc(\"Supplier\", doc.supplier) %}\n\n    <div class=\"card\">\n        <div>\n            <span class=\"label\">Vendor Category:</span>\n            <span class=\"badge\">{{ supplier.custom_vendor_category or \"N/A\" }}</span>\n        </div>\n\n        <div style=\"margin-top: 10px;\">\n            <span class=\"label\">Vendor Rating:</span>\n            <span class=\"rating\">\n                {{ rating_stars(supplier.custom_vendor_rating) }}\n            </span>\n            <span class=\"rating-number\">\n                ({{ supplier.custom_vendor_rating or 0 }})\n            </span>\n        </div>\n\n        {% if supplier.custom_vendor_rating and supplier.custom_vendor_rating < 3 %}\n        <div class=\"warning\">\n            ⚠️ Caution: Low-rated vendor. Please review before proceeding.\n        </div>\n        {% endif %}\n    </div>\n\n    <div class=\"card\">\n        <div class=\"label\" style=\"margin-bottom: 10px;\">Items</div>\n        <table class=\"table\">\n            <thead>\n                <tr>\n                    <th>Item</th>\n                    <th style=\"text-align:right;\">Qty</th>\n                    <th style=\"text-align:right;\">Rate</th>\n                    <th style=\"text-align:right;\">Amount</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                <tr>\n                    <td>{{ item.item_name }}</td>\n                    <td style=\"text-align:right;\">{{ item.qty }}</td>\n                    <td style=\"text-align:right;\">{{ item.rate }}</td>\n                    <td style=\"text-align:right;\">{{ item.amount }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n\n        <div class=\"total-box\">\n            Grand Total: ₹ {{ doc.grand_total }}\n        </div>\n    </div>\n\n    <div class=\"footer\">\n        Generated via Vendor Portal • Confidential • {{ frappe.utils.nowdate() }}\n    </div>\n\n</div>",
